# Copy the Session pooler URI from Supabase Connect; keep its username, host, and port.
DATABASE_URL=postgresql://postgres.project-ref:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
PORT=3000
# Keep true for HTTPS Preview and production. Set false only for plain HTTP local testing.
COOKIE_SECURE=true
# Optional: set a strong secret to enable the Admin Registration form.
# Never commit the real value; configure it as a managed runtime secret.
ADMIN_SIGNUP_CODE=replace-with-a-managed-secret
# SMTP provider settings for account verification and password resets.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=Youth Portal <no-reply@example.com>
# Use the public HTTPS origin in production so reset links point to the live site.
APP_BASE_URL=http://localhost:3000
